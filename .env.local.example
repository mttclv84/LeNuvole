# Copiare in .env.local e compilare con i valori del progetto Supabase
# (Project Settings > API).

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Solo per script server-only (seed, gestione utenti da pannello staff).
# NON esporre mai al client, non deve avere prefisso NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
